{
  "name": "@plainlist/web",
  "version": "2.4.4",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "npm run build -w @plainlist/shared",
    "dev": "vite",
    "prebuild": "npm run build -w @plainlist/shared",
    "build": "vue-tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.vue",
    "test": "vitest run src && node --test electron/chatgpt-local-sync.test.cjs electron/chatgpt-sync-scheduler.test.cjs electron/desktop-api.test.cjs && node --test scripts/production-api-contract.test.cjs && node --test scripts/verify-production-api-bundle.test.cjs && node --test scripts/verify-packaged-api-bundle.test.cjs",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "mobile:build": "npm run build && npx cap sync",
    "mobile:android": "npm run mobile:build && npx cap open android",
    "mobile:android:release": "bash scripts/build-android-release.sh",
    "mobile:ios": "npm run mobile:build && npx cap open ios",
    "desktop:build": "vue-tsc -p tsconfig.json --noEmit && vite build",
    "desktop:dist:mac": "bash scripts/build-desktop-release.sh --mac",
    "desktop:dist:mac:arm64": "bash scripts/build-desktop-release.sh --mac --arm64",
    "desktop:dist:mac:x64": "bash scripts/build-desktop-release.sh --mac --x64",
    "deploy:android": "bash scripts/deploy-android.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@plainlist/shared": "*",
    "echarts": "^6.0.0",
    "matter-js": "^0.20.0",
    "pinia": "^3.0.4",
    "three": "^0.160.1",
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^7.3.1",
    "vue-tsc": "^3.1.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
